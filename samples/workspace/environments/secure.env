# The same suite over HTTPS, with the self-signed certificate. With the default
# "warn" TLS setting every response carries a certificate warning.
baseUrl=https://localhost:8443
username=demo
password=demo-password
apiKey=sample-api-key
userName=Ada Lovelace
userEmail=ada@example.com
greeting=hello world
nested={{userName}}
tlsSelfSignedUrl=https://localhost:8443
tlsExpiredUrl=https://localhost:8444
tlsNotYetValidUrl=https://localhost:8445
tlsWrongHostUrl=https://localhost:8446
tlsPrivateCaUrl=https://localhost:8447
