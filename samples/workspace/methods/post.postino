POST {{baseUrl}}/anything/methods

::: body json
{ "name": "{{userName}}" }

::: post
test("status is 200", () => {
  expect(res.status).toBe(200);
});
test("the server saw POST", () => {
  expect(res.json().method).toBe("POST");
});

test("body reached the server", () => {
  expect(res.json().json).toEqual({ name: env.get("userName") });
});
