GET {{baseUrl}}/anything/methods

::: query
source = sample

::: post
test("status is 200", () => {
  expect(res.status).toBe(200);
});
test("the server saw GET", () => {
  expect(res.json().method).toBe("GET");
});

test("query reached the server", () => {
  expect(res.json().args.source).toBe("sample");
});
