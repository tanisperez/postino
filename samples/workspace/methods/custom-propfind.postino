PROPFIND {{baseUrl}}/anything/dav
Depth: 1

::: body xml
<?xml version="1.0"?>
<propfind xmlns="DAV:"><allprop/></propfind>

::: post
test("status is 200", () => {
  expect(res.status).toBe(200);
});
test("the server saw PROPFIND", () => {
  expect(res.json().method).toBe("PROPFIND");
});

test("the XML body arrived", () => {
  expect(res.json().body).toContain("<allprop/>");
  expect(res.json().headers.depth).toBe("1");
});
