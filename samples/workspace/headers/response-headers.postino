GET {{baseUrl}}/response-headers

::: query
X-Custom-One = 1
X-Custom-Two = two words

::: post
test("response headers are readable, whatever the case", () => {
  expect(res.headers.get("X-Custom-One")).toBe("1");
  expect(res.headers.get("X-CUSTOM-TWO")).toBe("two words");
  expect(res.headers.get("x-missing")).toBeFalsy();
});
