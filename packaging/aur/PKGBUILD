# Maintainer: Estanislao Pérez Nartallo <tanisperez@gmail.com>
#
# Template of the AUR package `postino-bin`. `pkgver` and the checksum are filled in for each
# release (`updpkgsums`, or by CI once the AUR account exists, see packaging/aur/README.md).
pkgname=postino-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Lightweight native HTTP client, requests are plain local files'
arch=('x86_64')
url='https://postino.tanis.codes'
license=('Apache-2.0')
depends=('libxkbcommon' 'libxkbcommon-x11' 'libxcb' 'wayland' 'libglvnd')
optdepends=('vulkan-icd-loader: Vulkan renderer')
provides=('postino')
conflicts=('postino')
source=("postino-$pkgver-linux-x86_64.tar.gz::https://github.com/tanisperez/postino/releases/download/v$pkgver/postino-$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "postino-$pkgver-linux-x86_64"
    install -Dm755 bin/postino "$pkgdir/usr/bin/postino"
    cp -r share "$pkgdir/usr/share"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
